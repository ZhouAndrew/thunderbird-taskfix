{
  "manifest_version": 2,
  "name": "Thunderbird CalDAV Lab",
  "description": "Direct Thunderbird Tasks and Calendar workspace. Reads and writes through Thunderbird's own calendar providers; no Native Host or companion CalDAV client.",
  "version": "0.3.2",
  "author": "ZhouAndrew",
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ZhouAndrew.thunderbird-taskfix-lab@addons.thunderbird.net",
      "strict_min_version": "153.0",
      "strict_max_version": "153.*"
    }
  },
  "experiment_apis": {
    "TaskFix": {
      "schema": "api/TaskFix/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["TaskFix"]],
        "script": "api/TaskFix/implementation.js",
        "events": ["startup"]
      }
    },
    "ThunderbirdCalDAV": {
      "schema": "api/ThunderbirdCalDAV/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["ThunderbirdCalDAV"]],
        "script": "api/ThunderbirdCalDAV/implementation.js"
      }
    }
  }
}
